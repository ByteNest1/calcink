{
  "name": "calcink",
  "version": "1.0.0",
  "description": "CalcInk \u2014 on-device handwritten math calculator. Write an equation ending in \"=\" and the answer appears inline, computed 100% in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "tsx scripts/benchmark-recognition.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "onnxruntime-web": "^1.30.0",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "handwriting",
    "onnx",
    "digital-ink",
    "calculator",
    "pwa"
  ]
}
